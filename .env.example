# Copy to .env and fill in the keys for the providers your config uses.
# A key already set in your shell wins over this file.
# A maker's own key is used ahead of OpenRouter whenever it is set.

# Makers' own keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Everything else goes through OpenRouter, or Nous when only its key is set
NOUS_API_KEY=
OPENROUTER_API_KEY=
