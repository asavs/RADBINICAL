# Copy to .env and fill in the keys for the providers your config uses.
# A key already set in your shell wins over this file.

# Makers' own keys. Anthropic's, OpenAI's, Google's and xAI's models are sent only to these;
# without the key such a reader cannot run. NVIDIA's go through a shared provider without one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=

# Everything else goes through Nous, or OpenRouter when only its key is set
NOUS_API_KEY=
OPENROUTER_API_KEY=
